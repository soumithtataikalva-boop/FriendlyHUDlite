+	private function GetFHUDPriceComparison( item : SItemUniqueId, inventory : CInventoryComponent, shopPrice : int ) : string
+	{
+		var basePrice : float;
+		var percentage : float;
+		basePrice = (float)inventory.GetItemPrice( item );
