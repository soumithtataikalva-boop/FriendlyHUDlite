+			basePrice /= 10.0f;
+		if( basePrice <= 0 )
+			return "";
+		percentage = (float)shopPrice * 100.0f / basePrice;
+		return " [" + FloatToStringPrec( basePrice, 2 ) + " : " + RoundMath( percentage ) + "%]";
